---
import Base from '../layouts/Base.astro';

const decisions = [
  { slug: 'marketing-hub-architecture-v1', date: 'Apr 16 2026', status: 'Ratified', desc: 'Agent Chain architecture: 8 tenants × CrewAI master hub' },
  { slug: 'zonewise-enterprise-gate-v1', date: 'Apr 16 2026', status: 'Ratified', desc: '38-criterion enterprise gate for ZoneWise.AI paid GTM' },
  { slug: 'RATIFICATION-LOG-2026-04-16', date: 'Apr 16 2026', status: 'Living', desc: '11 decisions locked in chat session hub-v01-day0-2026-04-16' },
  { slug: 'crewai-master-hub-adoption', date: 'Apr 16 2026', status: 'Ratified', desc: 'kortix-ai/suna REJECTED (Elastic L2.0) → crewAIInc/crewAI ADOPTED (MIT, REPOEVAL 92)' },
];
---
<Base title="SSOT Viewer">
  <div class="eyebrow mb-2">◢ /ssot</div>
  <h1 class="text-3xl font-extrabold text-white mb-2">SSOT Viewer</h1>
  <p class="text-everest-text-dim mb-8 max-w-2xl">Single Source of Truth — ratified architecture and gate decisions. Source: <code class="font-mono text-everest-orange text-sm">breverdbidder/everest-vault/decisions/</code></p>

  <div class="grid gap-3">
    {decisions.map(d => (
      <div class="card">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div>
            <div class="font-mono text-xs text-everest-orange mb-1">decisions/{d.slug}.md</div>
            <div class="text-white font-medium">{d.desc}</div>
          </div>
          <div class="text-right">
            <div class="text-[11px] font-mono text-everest-text-muted">{d.date}</div>
            <div class="text-[11px] font-mono text-everest-green">{d.status}</div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <p class="mt-8 text-[12px] font-mono text-everest-text-muted">Live doc rendering from Markdown wires in Day 2-3 of sprint (needs Cloudflare Access + Supabase sync).</p>
</Base>
